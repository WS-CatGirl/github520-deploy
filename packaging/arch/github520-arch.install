post_install() {
    cat <<'EOF'
GitHub520 Arch package installed.

Next steps:
  sudo github520-arch install   # apply hosts and enable the hourly timer
  sudo github520-arch update    # refresh hosts immediately
  github520-arch status         # show timer and hosts state

To remove: run "sudo github520-arch --uninstall-completely" first, then
"sudo pacman -Rns github520-arch".
EOF
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now github520-update.timer >/dev/null 2>&1 || true
    systemctl stop github520-update.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
}
